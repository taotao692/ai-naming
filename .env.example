# 复制成 .env 后填写（.env 已被 .gitignore 忽略）
# 本机 vercel dev 会读取；线上在 Vercel 项目 Settings → Environment Variables 配同名变量
# 四家都是可选：没有密钥的那家，页面下拉框会灰显「未配置密钥」

# ---------- Supabase ----------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# ---------- 豆包（火山方舟） ----------
DOUBAO_API_KEY=ark-xxxxxxxxxxxxxxxxxxxx
# 接入点 ID（ep- 开头）或已开通的模型名
ARK_MODEL=ep-xxxxxxxxxxxx-xxxxx
# 需要长推理时再打开；默认关闭，首字延迟能从 30s+ 降到 2s 内
# DOUBAO_THINKING=on

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_MODEL=deepseek-chat

# ---------- 通义千问 DashScope ----------
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# QWEN_MODEL=qwen-plus

# ---------- Kimi Moonshot ----------
MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# KIMI_MODEL=moonshot-v1-8k
